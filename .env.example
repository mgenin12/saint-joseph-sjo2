SHEET_ID="1JXFBY3ZQwOT66k0cUUZUgv79xVxbC0oDMZ44NDMM_gQ"
SHEET_GID_ARTICLES="0"
SHEET_GID_CATEGORIES="659450165"
# À renseigner quand les onglets existent (voir README)
SHEET_GID_EVENEMENTS=""
