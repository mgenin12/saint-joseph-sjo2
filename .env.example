# Secret pour forcer une mise à jour immédiate : POST /api/revalidate?secret=...
REVALIDATE_SECRET="changez-moi"

# Afficher aussi les brouillons (déploiements de prévisualisation Vercel : automatique)
AFFICHER_BROUILLONS="false"

# Optionnel : webhook recevant les formulaires (Formspree, Make, Zapier, Apps Script…)
CONTACT_WEBHOOK_URL=""
NEWSLETTER_WEBHOOK_URL=""
